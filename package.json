{
  "name": "eazyqq",
  "version": "0.5.6",
  "packageManager": "pnpm@11.14.0",
  "description": "Zero-CLI out-of-the-box personal QQ AI assistant client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:resources": "node scripts/sync-napcat-resources.mjs",
    "build": "node scripts/version/check.mjs && node scripts/contracts/check.mjs && node scripts/sync-napcat-resources.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "pwsh -NoProfile -File scripts/tauri.ps1 dev",
    "tauri:build": "pwsh -NoProfile -File scripts/tauri.ps1 build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "pwsh -NoProfile -File scripts/cargo.ps1 test --all-targets",
    "version:check": "node scripts/version/check.mjs",
    "test:smoke": "python scripts/validation/cli_smoke.py",
    "test:native": "python scripts/validation/native_profiles.py",
    "release:package": "pwsh -NoProfile -File scripts/release/package.ps1",
    "contracts:check": "node scripts/contracts/check.mjs",
    "contracts:write": "node scripts/contracts/check.mjs --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
